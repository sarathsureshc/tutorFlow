# Database connection string (Supabase Connection Pooler with transaction mode)
# Format: postgresql://[user].[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Note: If password contains special characters like @, percent-encode it (e.g. @ -> %40)
DATABASE_URL="postgresql://postgres.koxxlvfvedoftuwpxmxk:[YOUR_ENCODED_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct URL for Prisma migrations (Session mode on port 5432)
DIRECT_URL="postgresql://postgres.koxxlvfvedoftuwpxmxk:[YOUR_ENCODED_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Supabase API credentials
NEXT_PUBLIC_SUPABASE_URL="https://koxxlvfvedoftuwpxmxk.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key"

# Custom JWT Secret (minimum 32 characters)
JWT_SECRET="tutorflow_super_secret_production_key_2026_minimum_32_chars_long!"

# Google Gemini API Key (from https://aistudio.google.com/)
GEMINI_API_KEY="your_gemini_api_key_here"

# Node environment
NODE_ENV="production"
