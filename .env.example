# Database connection string (PostgreSQL via Supabase/Neon, or local PostgreSQL)
# Example: postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tutorflow?schema=public"

# Direct URL for Prisma migrations when using connection poolers (Supabase/Neon)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/tutorflow?schema=public"

# Custom JWT Secret (minimum 32 characters)
JWT_SECRET="tutorflow_super_secret_production_key_2026_minimum_32_chars_long!"

# Google Gemini API Key (get free key from https://aistudio.google.com/)
GEMINI_API_KEY=""

# Node environment
NODE_ENV="development"
